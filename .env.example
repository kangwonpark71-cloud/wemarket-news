# Database - Railway에서 자동 생성됨
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Cron Job Authentication
CRON_SECRET="your-secret-key-here"

# LLM API Key (for AI summarization)
OPENAI_API_KEY="sk-..."

# Redis URL (for caching layer - falls back to in-memory cache if not set)
REDIS_URL="redis://default:password@host:6379"

# Article retention (days) - old articles auto-deleted to prevent DB volume overflow
ARTICLE_RETENTION_DAYS="90"

# Sentry (optional)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# App URL
NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"

# Session Auth Secret (required, min 32 chars)
JWT_SECRET="your-secret-key-at-least-32-characters-long"

# Naver Open API (News Search) — https://developers.naver.com/apps/
NAVER_CLIENT_ID="your-client-id"
NAVER_CLIENT_SECRET="your-client-secret"

# KMA Weather API Key (기상청 날씨 API)
KMA_AUTH_KEY="your-kma-api-key"

# SMS Provider (twilio | mock)
TWILIO_ACCOUNT_SID="your-twilio-sid"
TWILIO_AUTH_TOKEN="your-twilio-token"
TWILIO_PHONE_NUMBER="+1234567890"

# PWA Push Notifications (VAPID keys)
# Generate with: node -e "const c=require('crypto');const k=c.generateKeyPairSync('ec',{namedCurve:'P-256'});console.log('public:',k.publicKey.export({type:'spki',format:'pem'}).replace(/-----[\w ]+-----/g,'').replace(/\n/g,''));console.log('private:',k.privateKey.export({type:'pkcs8',format:'pem'}).replace(/-----[\w ]+-----/g,'').replace(/\n/g,''))"
PUSH_VAPID_PUBLIC="your-vapid-public-key"
PUSH_VAPID_PRIVATE="your-vapid-private-key"
